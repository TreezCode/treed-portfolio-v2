# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/playwright/
/.impeccable/review/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tailwindcss-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify
.netlify

# perf test outputs (keep scripts/docs, ignore generated results)
perf/lighthouse-results/
perf/playwright/results/
perf/playwright/report/

# typescript
*.tsbuildinfo
next-env.d.ts

# documentation (personal notes, keep local only)
/docs/

# Native before/after capture masters stay local; track their guides and manifests.
/content/portfolio-refresh-2026-11-03/**/*.png
/content/portfolio-refresh-2026-11-03/**/*.webm
/content/portfolio-refresh-2026-11-03/**/*.mp4

# Standalone Russound runtime, media staging and generated release artifacts.
/experiences/russound/node_modules/
/experiences/russound/.astro/
/experiences/russound/.cache/
/experiences/russound/dist/
/experiences/russound/public/
/experiences/russound/release/upload/
/experiences/russound/release/*.zip
/experiences/russound/evidence/
/experiences/russound/**/__pycache__/
