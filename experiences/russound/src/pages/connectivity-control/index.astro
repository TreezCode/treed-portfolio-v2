---
import DirectionLayout from '../../components/handoff/DirectionLayout.astro';
const groups = [
 {name:'Keypads & Touchscreens',models:'XTS7 · IPK-1 · USRC',copy:'Dedicated controls for compatible Russound systems.',href:'https://russound.com/audio-systems/multiroom-controllers/mca-series/keypads-and-touchscreens/'},
 {name:'Speaker Selectors',copy:'Explore ways to select connected speakers.',href:'https://russound.com/connectivity-and-control/speaker-selectors/'},
 {name:'Volume Controls',copy:'Adjust listening levels from a control in the room.',href:'https://russound.com/connectivity-and-control/volume-controls/'},
 {name:'Infrared Systems',copy:'Explore infrared control and distribution.',href:'https://russound.com/connectivity-and-control/infrared-systems/'},
 {name:'Wall Plates',copy:'Find connection points for a considered installation.',href:'https://russound.com/connectivity-and-control/wall-plates/'},
];
---
<DirectionLayout title="Russound | Connectivity & Control" description="Explore Russound touchscreens, keypads, selectors, volume controls, infrared systems and wall plates.">
 <div class="hc-page">
  <nav class="hc-crumb d-wrap" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Connectivity &amp; Control</span></nav>
  <section class="hc-hero" aria-labelledby="hc-title"><div class="hc-photo"><img src="/media/kitchen-1600.webp" width="1600" height="1067" alt="A listener uses a Russound XTS7 touchscreen in the kitchen" fetchpriority="high"/></div><div class="hc-intro"><p class="hc-eyebrow">Connectivity &amp; Control</p><h1 id="hc-title">The right music.{' '}<br/>Right at hand.</h1><p>Choose how you control the sound. Explore the interfaces and connections that make your system part of everyday life.</p><a class="d-link" href="#control-families">Explore the range <span aria-hidden="true">↓</span></a></div></section>
  <section class="d-wrap hc-groups" id="control-families" aria-labelledby="hc-groups-title"><div class="hc-group-heading"><h2 id="hc-groups-title">A place for{' '}<br/>every connection.</h2><p>Your installer helps match controls and connections to the system. Each family below opens its current Russound collection.</p></div><div class="hc-directory">{groups.map((g,i)=><a href={g.href}><span class="hc-number">{String(i+1).padStart(2,'0')}</span><div><h3>{g.name}</h3>{g.models&&<p class="hc-models">{g.models}</p>}<p>{g.copy}</p></div><span class="hc-arrow" aria-hidden="true">↗</span></a>)}</div></section>
  <section class="hc-product d-wrap"><div><img src="/media/xts7.webp" alt="Russound XTS7 touchscreen" width="1200" height="900" loading="lazy"/></div><div><p class="hc-eyebrow">XTS7</p><h2>Your music,{' '}<br/>within reach.</h2><p>A dedicated wall-mounted touchscreen brings the Russound App into the room.</p><a class="d-link" href="https://russound.com/products/xts7-wall-mounted-7-color-touchscreen/">Explore the XTS7 <span aria-hidden="true">↗</span></a></div></section>
 </div>
</DirectionLayout>
<style>
.hc-crumb{display:flex;gap:15px;font-size:11px;padding-block:25px;color:var(--muted)}.hc-crumb a{text-decoration:none}.hc-hero{display:grid;grid-template-columns:1.15fr 1fr;background:var(--surface)}.hc-photo{min-width:0;min-height:580px}.hc-photo img{width:100%;height:100%;object-fit:cover;object-position:46% center}.hc-intro{align-self:center;padding:65px clamp(28px,6vw,100px)}.hc-eyebrow{font-size:12px;color:var(--muted);margin-bottom:24px}.hc-intro h1{font-size:clamp(40px,4.5vw,72px);letter-spacing:-.055em;line-height:1.07;font-weight:450}.hc-intro>p:not(.hc-eyebrow){max-width:37ch;font-size:15px;color:var(--muted);margin:28px 0}.hc-intro .d-link{margin-top:12px}.hc-groups{padding-block:95px}.hc-group-heading{display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:end;margin-bottom:44px}.hc-group-heading h2,.hc-product h2{font-size:clamp(36px,4vw,62px);font-weight:450;letter-spacing:-.045em}.hc-group-heading>p{max-width:45ch;font-size:14px;color:var(--muted)}.hc-directory{border-top:1px solid var(--rule)}.hc-directory>a{display:grid;grid-template-columns:40px 1fr 35px;gap:24px;align-items:start;padding:32px 0;border-bottom:1px solid var(--rule);text-decoration:none}.hc-number{font-size:11px;color:var(--muted);padding-top:8px}.hc-directory h3{font-size:28px;font-weight:450;letter-spacing:-.03em}.hc-directory p{font-size:13px;color:var(--muted);margin-top:10px}.hc-directory .hc-models{color:var(--brand-blue);font-weight:600}.hc-arrow{font-size:25px;transition:transform .2s}.hc-directory>a:hover .hc-arrow{transform:translate(3px,-3px)}.hc-directory>a:hover h3{text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:1px}.hc-product{display:grid;grid-template-columns:1fr 1fr;gap:10vw;align-items:center;padding-block:80px;background:var(--surface)}.hc-product img{width:100%;max-height:340px;object-fit:contain;mix-blend-mode:multiply}.hc-product p:not(.hc-eyebrow){font-size:14px;color:var(--muted);max-width:37ch;margin:24px 0}.hc-product .d-link{margin-top:12px}.hc-page a:focus-visible{outline:2px solid var(--brand-blue);outline-offset:5px}@media(max-width:760px){.hc-hero{grid-template-columns:1fr}.hc-photo{min-height:0;height:340px}.hc-intro{padding:40px var(--gutter) 50px}.hc-intro h1{font-size:47px}.hc-group-heading{grid-template-columns:1fr;gap:25px}.hc-groups{padding-block:55px}.hc-directory>a{grid-template-columns:24px 1fr 24px;gap:15px;padding-block:25px}.hc-directory h3{font-size:26px}.hc-product{grid-template-columns:1fr;gap:35px;padding-block:50px}.hc-product img{max-height:250px}}@media(prefers-reduced-motion:reduce){.hc-arrow{transition:none;transform:none!important}}
</style>
