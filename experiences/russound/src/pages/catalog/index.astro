---
import DirectionLayout from '../../components/handoff/DirectionLayout.astro';
import { reviewFamilies, reviewProducts, useOptions, groupOptions } from '../../data/handoff-catalog';
---
<DirectionLayout title="Find your sound | Russound product collection" description="Explore Russound products by family, product type and the way you want to listen." active="products">
 <div class="rv-catalog d-wrap" data-review-catalog>
  <nav class="rv-crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Product collection</span></nav>
  <section class="rv-catalog-intro"><div><p class="rv-eyebrow">Designed around your space</p><h1>Find your{' '}<br/>kind of sound.</h1></div><div><p>Start with a family, a room or a way to listen. Explore the products, then shape the right system with your installer.</p><a class="d-link" href="/audio-systems/">Discover whole-home audio <span aria-hidden="true">↗</span></a></div></section>
  <div class="rv-catalog-controls" aria-label="Filter products"><div><label for="rv-family-filter">Product family</label><select id="rv-family-filter" data-filter-family><option value="">All families</option>{reviewFamilies.map(f=><option value={f.id}>{f.name}</option>)}</select></div><div><label for="rv-group-filter">Product type</label><select id="rv-group-filter" data-filter-group><option value="">All types</option>{groupOptions.map(g=><option value={g.id}>{g.name}</option>)}</select></div><div><label for="rv-use-filter">Explore by use</label><select id="rv-use-filter" data-filter-use><option value="">Any use</option>{useOptions.map(u=><option value={u.id}>{u.name}</option>)}</select></div><div><label for="rv-query-filter">Find a model</label><input id="rv-query-filter" type="search" data-filter-query placeholder="Model or product" maxlength="100"/></div></div>
  <div class="rv-catalog-meta"><p data-filter-count role="status" aria-live="polite">{reviewProducts.length} products</p><button type="button" data-filter-reset>Clear filters <span aria-hidden="true">↺</span></button></div>
  <div class="rv-catalog-grid">{reviewProducts.map(p=><article class="rv-product-card" data-catalog-product={p.id} data-family={(p.discoveryFamilies||[p.family]).join(' ')} data-group={p.group} data-uses={p.uses.join(' ')} data-search={[p.id,p.name,p.description,...p.aliases||[]].join(' ').toLowerCase()}><a class="rv-product-art" href={p.href} aria-label={`Explore ${p.id}`}><img src={p.image} width="700" height="450" alt={`Russound ${p.id}`} loading="lazy"/></a><div class="rv-product-body"><p class="rv-product-family">{reviewFamilies.find(f=>f.id===p.family)?.name}</p><h2><a href={p.href}>{p.id}</a></h2><p class="rv-product-name">{p.name}</p><p class="rv-product-description">{p.description}</p><a class="d-link" href={p.href}>Explore product <span aria-hidden="true">↗</span></a></div></article>)}</div>
  <div class="rv-catalog-empty" data-filter-empty hidden><h2>A different way to look.</h2><p>No products in this selection match all your filters. Clear a filter or explore the complete Russound range.</p><a class="d-link" href="https://russound.com/products/">Explore all Russound products ↗</a></div>
  <p class="rv-catalog-note">A selected collection for this portfolio concept. SMZ8 opens the complete concept page; other product links open Russound’s current website. <a href="https://russound.com/products/">Browse the full range ↗</a></p>
  <noscript><p class="rv-catalog-note">All selected products are listed below the filters. Enable JavaScript to filter the collection, or follow the product links directly.</p></noscript>
  <section class="rv-catalog-help"><div><p class="rv-eyebrow">Make it your own</p><h2>The right system{' '}<br/>starts with your space.</h2><p>Tell us how you want to listen. Bring a starting brief to a Russound installer.</p></div><a class="d-button" href="/#planner">Plan a system <span aria-hidden="true">↗</span></a></section>
 </div>
</DirectionLayout>
