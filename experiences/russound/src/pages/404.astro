---
import '@fontsource-variable/manrope';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#f7f4ee" />
    <link rel="icon" href="data:," />
    <title>Page not found | Russound portfolio concept</title>
  </head>
  <body>
    <main>
      <p>Russound portfolio concept</p>
      <h1>Page not found.</h1>
      <a href="/">Explore the experience <span aria-hidden="true">↗</span></a>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f7f4ee; color: #252522; font-family: 'Manrope Variable', sans-serif; }
  main { min-height: 100svh; max-width: 76rem; margin: auto; padding: clamp(2rem, 8vw, 8rem); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  p { margin: 0 0 1.5rem; color: #62605b; font-size: .875rem; }
  h1 { margin: 0 0 2.5rem; font-size: clamp(2.75rem, 8vw, 6.5rem); line-height: 1.05; letter-spacing: -.05em; font-weight: 500; }
  a { display: inline-flex; align-items: center; gap: 2rem; padding: 1rem 1.5rem; background: #0f2a4d; color: #fff; font-size: .875rem; text-decoration: none; }
  a:hover { background: #243c70; }
  a:focus-visible { outline: 3px solid #a46c45; outline-offset: 5px; }
</style>
