---
import { reviewFamilies, reviewProducts } from '../../data/handoff-catalog';
import { navigationResources as resources, supportGroups, aboutLinks, mobileResourceGroups } from '../../data/handoff-navigation';
import SearchDialog from './SearchDialog.astro';
import AnnouncementStrip from './AnnouncementStrip.astro';
import '../../styles/handoff-discovery.css';
import '../../styles/handoff-navigation.css';
interface Props { active?: string; }
const { active = '' } = Astro.props;
// Presentation only. The existing family list remains the navigation source of truth.
const featuredModels = {
  audio: ['SMZ8', 'SMZ16-PRE', 'MBX-AMP'],
  amplifiers: ['D1290'],
  speakers: ['IC-620', '5B65mk2-W', '5R82mk2-S', 'Cinema Bar 3.0'],
  control: ['XTS7', 'IPK-1'],
};
const featureDimensions = { audio: [1200, 535], amplifiers: [1400, 231], speakers: [1000, 998], control: [1000, 682] };
const arrowPath = 'M5 19 19 5M5 5h14v14';
---
<header class="rv-header rv-navigation-selected" id="direction-header">
  <AnnouncementStrip />
  <div class="rv-brand-bar">
    <a class="rv-wordmark" href="/" aria-label="Russound home"><img src="/media/logo-white.webp" width="360" height="81" alt="Russound" /></a>
  <nav class="rv-resource-bar" aria-label="Russound resources">
    <a href={resources.apps.href}>{resources.apps.label}</a>
    <details class="rv-resource-menu" data-rv-utility-menu name="desktop-navigation">
      <summary>Support<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></summary>
      <div class="rv-resource-dropdown">
        {supportGroups.map(group => <section><h2>{group.label}</h2><ul>{group.links.map(key => <li><a href={resources[key].href}>{resources[key].label}</a></li>)}</ul></section>)}
      </div>
    </details>
    <a href={resources.news.href}>{resources.news.label}</a>
    <details class="rv-resource-menu" data-rv-utility-menu name="desktop-navigation">
      <summary>About Russound<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></summary>
      <div class="rv-resource-dropdown rv-resource-dropdown-about"><ul>{aboutLinks.map(key => <li><a href={resources[key].href}>{key === 'company' ? 'Company' : resources[key].label}</a></li>)}</ul></div>
    </details>
    <a href={resources.contact.href}>Contact</a>
    <a class="rv-integrator-link" href={resources.integrator.href}>{resources.integrator.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a>
  </nav>
  </div>
  <div class="rv-bar">
    <a class="rv-wordmark" href="/" aria-label="Russound home"><img src="/media/logo-white.webp" width="360" height="81" alt="Russound" /></a>
    <nav class="rv-desktop" aria-label="Product navigation">
      {reviewFamilies.map(f => {
        const products = featuredModels[f.id].map(id => reviewProducts.find(p => p.id === id && p.family === f.id)!).filter(Boolean);
        const product = products[0];
        const featureImage = f.id === 'audio' ? '/navigation31/smz8-on-table.webp' : product.image;
        const featureCopy = f.id === 'speakers' ? 'Great sound. Beautifully integrated.' : f.featureCopy;
        return <details class="rv-family" data-rv-family name="desktop-navigation">
          <summary>{f.name}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></summary>
          <div class="rv-dropdown">
            <div class="rv-dropdown-inner">
              <div class="rv-menu-directory">
                <h2>{f.name}</h2>
                <div class="rv-menu-top">
                  <a class="rv-menu-all" href={f.allHref}>Explore {f.name.toLowerCase()} <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a>
                  <a href={resources.planner.href}>{resources.planner.label} <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a>
                </div>
                <div class="rv-menu-columns">
                  <section class="rv-menu-group" aria-labelledby={`nav-${f.id}-categories`}>
                    <h3 id={`nav-${f.id}-categories`}>Categories</h3>
                    <ul class="rv-menu-links">{f.links.map(l => <li><a href={l.href}>{l.name}</a></li>)}</ul>
                  </section>
                  <section class="rv-menu-group" aria-labelledby={`nav-${f.id}-featured`}>
                    <h3 id={`nav-${f.id}-featured`}>Featured</h3>
                    <ul class="rv-menu-links rv-featured-links">{products.map(p => <li><a href={p.href}>{p.id}</a></li>)}</ul>
                  </section>
                </div>
                <div class="rv-menu-bottom">
                  <a href={resources.browse.href}>{resources.browse.label} <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a>
                  <a href={resources.legacy.href}>{resources.legacy.label} <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a>
                </div>
              </div>
              <a href={product.href} class={`rv-menu-feature rv-menu-feature-${f.id}`} aria-label={`Discover Russound ${product.id}. ${featureCopy}`}>
                <div class="rv-menu-feature-art"><img src={featureImage} width={featureDimensions[f.id][0]} height={featureDimensions[f.id][1]} alt={`Russound ${product.id}`} loading="lazy" /></div>
                <div class="rv-menu-feature-copy"><strong>{featureCopy}</strong><span class="rv-menu-feature-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={arrowPath}/></svg></span></div>
              </a>
            </div>
          </div>
        </details>;
      })}
    </nav>
    <div class="rv-utility">
      <a href={resources.modelLookup.href} class="rv-search-open" aria-label="Search products and support" data-rv-search-open aria-haspopup="dialog" aria-controls="rv-search-dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg><span>Search</span></a>
      <a class="rv-dealer" href={resources.dealer.href}>{resources.dealer.label} <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a>
    </div>
    <details class="rv-mobile" data-rv-mobile>
      <summary aria-label="Navigation menu"><span class="rv-menu-icon" aria-hidden="true"><i></i><i></i></span><span>Menu</span></summary>
      <nav class="rv-mobile-panel" aria-label="Mobile navigation">
        <div class="rv-mobile-shortcuts"><a href={resources.browse.href}>{resources.browse.label}</a><a href={resources.planner.href}>{resources.planner.label}</a><a class="rv-integrator-link" href={resources.integrator.href}>{resources.integrator.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a></div>
        <div class="rv-mobile-families">{reviewFamilies.map(f => <details class="rv-mobile-family" data-rv-mobile-family name="mobile-product-family">
          <summary>{f.name}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></summary>
          <ul>{f.links.map(l => <li><a href={l.href}>{l.name}<svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a></li>)}<li><a class="rv-mobile-all" href={f.allHref}>See all {f.name.toLowerCase()} <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a></li></ul>
        </details>)}</div>
        <div class="rv-mobile-resources">{mobileResourceGroups.map(group => <section><h2>{group.label}</h2><ul>{group.links.map(key => <li><a href={resources[key].href}>{resources[key].label}</a></li>)}</ul></section>)}</div>
        <a class="rv-mobile-dealer" href={resources.dealer.href}>{resources.dealer.label} <svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrowPath}/></svg></a>
      </nav>
    </details>
  </div>
</header>
<SearchDialog />
