---
const marks = [
  { name: 'Spotify Connect', detail: 'From the Spotify app', image: '/streaming01/spotify-white.png', width: 3432, height: 940, kind: 'spotify' },
  { name: 'AirPlay 2', detail: 'From Apple devices', image: '/streaming01/airplay-supplied.svg', width: 248, height: 73, kind: 'airplay' },
  { name: 'Google Cast', detail: 'From compatible apps', image: '/streaming01/google-cast-inverse.png', width: 1895, height: 649, kind: 'cast', href: 'https://g.co/castapps' },
  { name: 'TIDAL', detail: 'In the Russound App', image: '/streaming01/tidal-white.png', width: 753, height: 100, kind: 'tidal' },
  { name: 'Deezer', detail: 'In the Russound App', image: '/streaming01/deezer-white.svg', width: 992, height: 279, kind: 'deezer' },
  { name: 'TuneIn', detail: 'In the Russound App', image: '/streaming01/tunein-white.svg', width: 201, height: 88, kind: 'tunein' },
  { name: 'SiriusXM', detail: 'In the Russound App', image: '/streaming01/siriusxm-white.png', width: 1200, height: 322, kind: 'siriusxm' },
];
---

<div class="lr" data-listening-rail>
  <div class="lr-shelf">
    <div class="lr-window">
      <div class="lr-track" data-rail-track>
        <ul class="lr-group" aria-label="Music services and connection methods for SMZ8" aria-describedby="listening-methods-intro">
          {marks.map((mark) => (
            <li class:list={['lr-item', `lr-${mark.kind}`]}>
              {mark.href ? (
                <a class="lr-brand" href={mark.href} aria-label="Google Cast compatible apps and products">
                  <img src={mark.image} width={mark.width} height={mark.height} alt="" loading="lazy" />
                </a>
              ) : (
                <span class="lr-brand">
                  <img src={mark.image} width={mark.width} height={mark.height} alt="" loading="lazy" />
                  <span class="lr-sr-only">{mark.name}: {mark.detail}.</span>
                </span>
              )}
            </li>
          ))}
        </ul>
        <ul class="lr-group lr-copy" aria-hidden="true">
          {marks.map((mark) => (
            <li class:list={['lr-item', `lr-${mark.kind}`]}>
              {mark.href ? (
                <a class="lr-brand" href={mark.href} tabindex="-1" data-rail-copy-link>
                  <img src={mark.image} width={mark.width} height={mark.height} alt="" loading="lazy" />
                </a>
              ) : (
                <span class="lr-brand"><img src={mark.image} width={mark.width} height={mark.height} alt="" loading="lazy" /></span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <button class="lr-toggle" type="button" data-rail-toggle hidden aria-label="Pause logo motion" title="Pause logo motion">
      <span class="lr-toggle-icon" aria-hidden="true"></span>
      <span class="lr-sr-only" data-rail-label>Pause logos</span>
    </button>
  </div>
  <div class="lr-meta">
    <details class="lr-options">
      <summary aria-label="Listening options">
        <span class="lr-intro" id="listening-methods-intro">Music services and connections for SMZ8.</span>
        <span class="lr-options-label">Listening options <span class="lr-options-icon" aria-hidden="true">+</span></span>
      </summary>
      <div class="lr-options-copy">
        <p><strong>In the Russound App:</strong> browse TIDAL, Deezer, TuneIn and SiriusXM on SMZ8.</p>
        <p><strong>From your favorite apps:</strong> use Spotify Connect from Spotify, AirPlay 2 from Apple devices, or Google Cast from compatible apps.</p>
        <p>The Russound App controls compatible Russound systems. Music services and connection methods vary by product. VoicePlay uses the separate VoicePlay App.</p>
      </div>
    </details>
    <p class="lr-attribution"><a href="https://g.co/castapps">Google Cast</a> is a trademark of Google LLC.</p>
  </div>
</div>

<style>
  .lr {
    position: relative;
    z-index: 2;
    margin-top: -44px;
    padding: 0 var(--gutter, 6vw) 24px;
    min-width: 0;
    color: #fff8ef;
  }
  .lr-shelf { display: flex; align-items: center; gap: 20px; max-width: 1240px; margin: 0 auto; }
  .lr-window { flex: 1; min-width: 0; overflow: hidden; }
  .lr-track { display: flex; width: 100%; }
  .lr-group { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); align-items: center; flex: 0 0 100%; width: 100%; min-width: 0; padding: 0; margin: 0; list-style: none; }
  .lr-copy { display: none; }
  .lr-item { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 84px; padding: 19px; }
  .lr-brand { display: inline-flex; align-items: center; justify-content: center; max-width: 100%; color: inherit; text-decoration: none; }
  a.lr-brand { min-height: 44px; }
  .lr-brand img { display: block; max-width: 100%; height: auto; object-fit: contain; }
  .lr-spotify img { width: 100px; }
  .lr-airplay img { width: 124px; }
  .lr-cast img { width: 128px; }
  .lr-tidal img { width: 120px; }
  .lr-deezer img { width: 100px; }
  .lr-tunein img { width: 74px; }
  .lr-siriusxm img { width: 110px; }
  .lr-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .lr-toggle { flex: 0 0 44px; align-self: flex-start; margin-top: 20px; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 1px solid #ffffff35; border-radius: 50%; background: transparent; color: #e1e6ed; cursor: pointer; }
  .lr-toggle[hidden] { display: none; }
  .lr-toggle:hover { background: #ffffff0a; border-color: #c9d5e3; }
  .lr-toggle-icon { position: relative; width: 10px; height: 12px; }
  .lr-toggle-icon::before, .lr-toggle-icon::after { content: ''; position: absolute; top: 1px; width: 2px; height: 10px; background: currentColor; }
  .lr-toggle-icon::before { left: 1px; }
  .lr-toggle-icon::after { right: 1px; }
  .lr[data-user-paused='true'] .lr-toggle-icon::before { top: 0; left: 1px; width: 0; height: 0; background: none; border-top: 6px solid transparent; border-bottom: 6px solid transparent; border-left: 9px solid currentColor; }
  .lr[data-user-paused='true'] .lr-toggle-icon::after { display: none; }
  .lr-meta { position: relative; max-width: 1240px; margin: 2px auto 0; }
  .lr-intro { flex: 1 1 18ch; min-width: 0; margin: 0; font-size: 12px; line-height: 1.65; color: #c9d5e3; }
  .lr-options summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; min-height: 44px; padding: 5px 0; font-size: 12px; color: #e1e6ed; cursor: pointer; list-style: none; }
  .lr-options-label { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 16px; margin-left: auto; min-height: 34px; }
  .lr-options summary::-webkit-details-marker { display: none; }
  .lr-options-icon { font-size: 19px; line-height: 1; font-weight: 400; }
  .lr-options[open] .lr-options-icon { transform: rotate(45deg); }
  .lr-options summary:hover { color: #fff8ef; }
  .lr-options-copy { padding: 8px 0 20px; max-width: 83ch; color: #d5dfe9; font-size: 13px; line-height: 1.75; }
  .lr-options-copy p { margin: 0 0 10px; }
  .lr-options-copy p:last-child { margin-bottom: 0; }
  .lr-options-copy strong { color: #fff8ef; font-weight: 550; }
  .lr-attribution { margin: 0; color: #bdccdd; font-size: 10px; line-height: 1.7; }
  .lr-attribution a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .lr a:focus-visible, .lr button:focus-visible, .lr summary:focus-visible { outline: 2px solid #f4b783; outline-offset: 5px; }
  .lr[data-mode='motion'] .lr-track { width: max-content; animation: lr-drift 126s linear infinite; will-change: transform; }
  .lr[data-mode='motion'] .lr-group { display: flex; flex: 0 0 auto; width: auto; }
  .lr[data-mode='motion'] .lr-item { flex: 0 0 168px; width: 168px; }
  .lr[data-mode='motion'] .lr-copy { display: flex; }
  .lr[data-mode='static'] .lr-track { animation: none; transform: none; }
  .lr[data-paused='true'] .lr-track { animation-play-state: paused; }
  @keyframes lr-drift { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (min-width: 761px) and (max-width: 1199px) {
    .lr-group { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .lr-shelf { gap: 8px; }
    .lr-item { padding-inline: 19px; }
  }
  @media (max-width: 760px) {
    .lr { margin-top: 0; padding-bottom: 26px; }
    .lr-shelf { display: block; }
    .lr .lr-track { width: 100% !important; animation: none !important; transform: none !important; will-change: auto !important; }
    .lr .lr-group { display: grid; flex-basis: 100% !important; width: 100% !important; grid-template-columns: repeat(2, minmax(0,1fr)); }
    .lr .lr-copy, .lr .lr-toggle { display: none !important; }
    .lr-item { min-height: 70px; padding: 14px 19px; }
    .lr-cast { padding-block: 19px; }
    .lr-item:last-child { grid-column: 1 / -1; }
    .lr-airplay img { width: 112px; }
    .lr-cast img { width: 112px; }
    .lr-tidal img { width: 108px; }
    .lr-meta { margin-top: 8px; }
    .lr-intro { font-size: 11px; }
    .lr-options summary { font-size: 11px; min-height: 48px; gap: 8px 16px; }
    .lr-options-label { gap: 9px; }
    .lr-attribution { margin-top: 7px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lr .lr-track { width: 100% !important; animation: none !important; transform: none !important; will-change: auto !important; }
    .lr .lr-group { flex-basis: 100% !important; width: 100% !important; }
    .lr .lr-copy, .lr .lr-toggle { display: none !important; }
  }
</style>

<script>
  const preferenceKey = 'russound-listening-rail-paused';
  document.querySelectorAll<HTMLElement>('[data-listening-rail]').forEach((rail) => {
    if (rail.dataset.initialized) return;
    rail.dataset.initialized = 'true';
    const button = rail.querySelector<HTMLButtonElement>('[data-rail-toggle]');
    const label = rail.querySelector<HTMLElement>('[data-rail-label]');
    const track = rail.querySelector<HTMLElement>('[data-rail-track]');
    const options = rail.querySelector<HTMLDetailsElement>('.lr-options');
    if (!button || !label || !track) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 760px)');
    let userPaused = false;
    try { userPaused = localStorage.getItem(preferenceKey) === 'true'; } catch { /* Storage is optional. */ }
    let onscreen = !('IntersectionObserver' in window);
    let hovered = rail.matches(':hover');
    let focused = rail.contains(document.activeElement);
    let brandFocused = track.contains(document.activeElement);
    let resumeHover = false;
    let resumeFocus = false;

    const update = () => {
      const motion = !reduced.matches && !mobile.matches;
      // Expose every mark for deliberate pauses, brand-link focus and open details.
      // Focusing a control only pauses motion, so it stays put during a pointer click.
      rail.dataset.mode = motion && !userPaused && !brandFocused && !options?.open ? 'motion' : 'static';
      rail.dataset.userPaused = String(userPaused);
      const interactionPaused = (hovered && !resumeHover) || (focused && !resumeFocus);
      rail.dataset.paused = String(!motion || userPaused || !onscreen || interactionPaused || options?.open || document.hidden);
      button.hidden = !motion;
      button.setAttribute('aria-label', userPaused ? 'Resume logo motion' : 'Pause logo motion');
      label.textContent = userPaused ? 'Resume logos' : 'Pause logos';
      button.title = userPaused ? 'Resume logo motion' : 'Pause logo motion';
    };

    button.addEventListener('click', () => {
      userPaused = !userPaused;
      // Explicit Play takes precedence over the interaction that activated it.
      // Keep focus on the button; later hover/focus interactions pause normally.
      resumeHover = !userPaused && hovered;
      resumeFocus = !userPaused && document.activeElement === button;
      try { localStorage.setItem(preferenceKey, String(userPaused)); } catch { /* Storage is optional. */ }
      update();
    });
    rail.querySelectorAll<HTMLAnchorElement>('[data-rail-copy-link]').forEach((link) => {
      // Visual duplicates remain clickable without entering keyboard or AT navigation.
      const keepCanonicalFocus = (event: Event) => { event.preventDefault(); };
      link.addEventListener('pointerdown', keepCanonicalFocus);
      link.addEventListener('mousedown', keepCanonicalFocus);
    });
    rail.addEventListener('mouseenter', () => { hovered = true; resumeHover = false; update(); });
    rail.addEventListener('mouseleave', () => { hovered = false; resumeHover = false; update(); });
    rail.addEventListener('pointerover', (event) => {
      if (resumeHover && event.target instanceof Node && !button.contains(event.target)) {
        resumeHover = false;
        update();
      }
    });
    rail.addEventListener('focusin', (event) => {
      focused = true;
      resumeFocus = false;
      brandFocused = event.target instanceof Node && track.contains(event.target);
      update();
      // A keyboard user always receives the complete first group, even late in a loop.
      if (event.target instanceof Node && track.contains(event.target)) {
        track.getAnimations().forEach((animation) => { animation.currentTime = 0; });
      }
    });
    rail.addEventListener('focusout', (event) => {
      resumeFocus = false;
      focused = event.relatedTarget instanceof Node && rail.contains(event.relatedTarget);
      brandFocused = event.relatedTarget instanceof Node && track.contains(event.relatedTarget);
      update();
    });
    options?.addEventListener('toggle', update);
    reduced.addEventListener('change', update);
    mobile.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        onscreen = entry.isIntersecting;
        update();
      });
      observer.observe(rail);
    }
    update();
  });
</script>
