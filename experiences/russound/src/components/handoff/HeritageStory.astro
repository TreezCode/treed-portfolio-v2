---
const milestones = [
  { year: '1967', title: 'A beginning in New Hampshire.', text: 'Russound is established.' },
  { year: '1987', title: 'A new chapter.', text: 'Maureen Baldwin acquires the company.' },
  { year: '1995', title: 'Engineering the experience.', text: 'Bill Ramsdell joins Russound.' },
  { year: '2014', title: 'Room for new ideas.', text: 'Colin Clark joins the product team.' },
  { year: '2027', title: 'The story continues.', text: 'Celebrating sixty years of Russound.' },
];
---
<section id="story" class="rf-heritage" aria-labelledby="heritage-heading" data-handoff-heritage>
  <div class="d-wrap">
    <div class="rf-heritage-intro">
      <div class="rf-anniversary" role="img" aria-label="60 years in 2027">
        <span class="rf-anniversary-number" data-anniversary-count aria-hidden="true">60</span>
        <span class="rf-anniversary-caption" aria-hidden="true">years in 2027</span>
        <span class="rf-anniversary-dates" aria-hidden="true">1967 &ndash; 2027</span>
      </div>
      <div class="rf-heritage-copy">
        <h2 id="heritage-heading">A lifetime{' '}<br />of listening.</h2>
        <p>From our New Hampshire beginnings to the homes and businesses we serve today. Looking ahead to sixty years of bringing people and music together.</p>
        <a class="d-link" href="https://russound.com/about-us/">Meet the people behind Russound <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
      </div>
      <figure class="rf-heritage-people">
        <img src="/oct28/russound-team.webp" width="626" height="402" alt="Members of the Russound team together" loading="lazy" />
        <figcaption>A sound relationship starts with people.</figcaption>
      </figure>
    </div>
    <div class="rf-timeline-wrap">
      <div class="rf-timeline-rule" aria-hidden="true"><span data-heritage-rule></span></div>
      <ol class="rf-timeline" aria-label="Russound milestones">
        {milestones.map(item => <li data-heritage-milestone><span class="rf-milestone-year">{item.year}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}
      </ol>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const heritageWindow = window as typeof window & { __refinementHeritageCleanup?: () => void };
  heritageWindow.__refinementHeritageCleanup?.();
  const root = document.querySelector<HTMLElement>('[data-handoff-heritage]');
  if (root) {
    const count = root.querySelector<HTMLElement>('[data-anniversary-count]')!;
    const number = root.querySelector<HTMLElement>('.rf-anniversary')!;
    const timeline = root.querySelector<HTMLElement>('.rf-timeline-wrap')!;
    const rule = root.querySelector<HTMLElement>('[data-heritage-rule]')!;
    const milestones = Array.from(root.querySelectorAll<HTMLElement>('[data-heritage-milestone]'));
    const media = gsap.matchMedia();
    const lifecycle = new AbortController();
    let disposed = false;
    let refreshFrame = 0;
    const scheduleRefresh = () => {
      if (disposed) return;
      cancelAnimationFrame(refreshFrame);
      refreshFrame = requestAnimationFrame(() => {
        refreshFrame = 0;
        if (disposed) return;
        ScrollTrigger.sort();
        ScrollTrigger.refresh();
      });
    };

    media.add({ motion: '(prefers-reduced-motion: no-preference)', wide: '(min-width: 901px)' }, context => {
      if (!context.conditions?.motion) return;
      const counter = { value: 0 };
      // A late load or restored reading position keeps the already visible final value.
      if (number.getBoundingClientRect().top > innerHeight * .88) {
        count.textContent = '0';
        gsap.to(counter, {
          value: 60, duration: 1.6, ease: 'power2.out',
          onUpdate: () => { count.textContent = String(Math.round(counter.value)); },
          scrollTrigger: { trigger: number, start: 'top 85%', once: true, refreshPriority: -10 },
        });
      }
      if (context.conditions.wide) {
        gsap.fromTo(rule, { scaleX: 0 }, {
          scaleX: 1, ease: 'none',
          // Upstream pinned sections must settle before measuring this painted rule.
          scrollTrigger: { trigger: timeline, start: 'clamp(top 88%)', end: 'clamp(top 48%)', scrub: .35, invalidateOnRefresh: true, refreshPriority: -10 },
        });
        gsap.from(milestones, {
          y: 26, duration: .85, stagger: .12, ease: 'power2.out',
          scrollTrigger: { trigger: timeline, start: 'top 88%', once: true, refreshPriority: -10 },
        });
      }
      return () => { count.textContent = '60'; };
    }, root);

    const dispose = () => {
      if (disposed) return;
      disposed = true;
      cancelAnimationFrame(refreshFrame);
      media.revert();
      count.textContent = '60';
      lifecycle.abort();
      if (heritageWindow.__refinementHeritageCleanup === dispose) delete heritageWindow.__refinementHeritageCleanup;
    };
    heritageWindow.__refinementHeritageCleanup = dispose;
    window.addEventListener('pagehide', dispose, { signal: lifecycle.signal });
    document.addEventListener('astro:before-swap', dispose, { signal: lifecycle.signal });
    window.addEventListener('load', scheduleRefresh, { once: true, signal: lifecycle.signal });
    document.fonts.ready.then(scheduleRefresh);
    scheduleRefresh();
    if (import.meta.hot) import.meta.hot.dispose(dispose);
  }
</script>

<style>
  .rf-heritage{background:var(--paper);padding-block:clamp(72px,8vw,132px);overflow:clip}
  .rf-heritage-intro{display:grid;grid-template-columns:.88fr 1.1fr .85fr;gap:clamp(26px,3.6vw,64px);align-items:center}
  .rf-anniversary{display:flex;flex-direction:column;align-items:flex-start;color:var(--brand-blue);min-width:0}
  .rf-anniversary-number{display:block;font-size:clamp(150px,19vw,325px);font-weight:400;letter-spacing:-.095em;line-height:.83;font-variant-numeric:tabular-nums}
  .rf-anniversary-caption{font-size:clamp(18px,1.65vw,27px);letter-spacing:-.03em;margin-top:22px}
  .rf-anniversary-dates{font-size:12px;letter-spacing:.12em;margin-top:15px;color:var(--muted)}
  .rf-heritage-copy{min-width:0}
  .rf-heritage-copy h2{font-size:clamp(40px,4.1vw,66px);max-width:13ch}
  .rf-heritage-copy>p{font-size:14px;color:var(--muted);max-width:39ch;margin:24px 0 15px}
  .rf-heritage-copy .d-link{gap:15px;font-size:12px}
  .rf-heritage-people{max-width:355px;justify-self:end;align-self:end;margin-bottom:7px}
  .rf-heritage-people img{width:100%;height:auto;aspect-ratio:626/402;object-fit:cover}
  .rf-heritage-people figcaption{font-size:11px;color:var(--muted);line-height:1.65;margin-top:13px;max-width:24ch}
  .rf-timeline-wrap{position:relative;margin-top:90px}
  .rf-timeline-rule{position:absolute;top:0;left:0;right:0;height:1px;background:var(--rule)}
  .rf-timeline-rule>span{display:block;height:100%;width:100%;background:var(--brand-highlight);transform-origin:left center}
  .rf-timeline{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(24px,3vw,52px);list-style:none;padding:0;margin:0}
  .rf-timeline li{padding-top:30px;position:relative;min-width:0}
  .rf-timeline li::before{content:'';position:absolute;width:7px;height:7px;border-radius:50%;background:var(--brand-blue);left:0;top:-3px}
  .rf-timeline li:last-child::before{background:var(--brand-highlight);box-shadow:0 0 0 5px var(--paper)}
  .rf-milestone-year{font-size:14px;font-variant-numeric:tabular-nums;color:var(--brand-blue)}
  .rf-timeline h3{font-size:clamp(18px,1.6vw,25px);max-width:14ch;margin:22px 0 12px;font-weight:500;line-height:1.25}
  .rf-timeline p{font-size:12px;color:var(--muted);max-width:22ch}
  @media(max-width:1100px){.rf-heritage-intro{grid-template-columns:.85fr 1.2fr;gap:30px 50px}.rf-heritage-people{grid-column:1;grid-row:2;justify-self:start;max-width:245px;margin:0}.rf-heritage-copy{grid-row:1/3;grid-column:2}.rf-anniversary-number{font-size:clamp(180px,24vw,265px)}.rf-heritage-copy h2{font-size:50px}.rf-timeline-wrap{margin-top:65px}}
  @media(max-width:900px){.rf-timeline{grid-template-columns:repeat(3,minmax(0,1fr));gap:38px 28px}.rf-timeline-rule{display:none}.rf-timeline li{border-top:1px solid var(--rule);padding-top:24px}.rf-timeline h3{font-size:22px;margin-top:18px}.rf-timeline p{max-width:26ch}}
  @media(max-width:600px){.rf-heritage-intro{grid-template-columns:1fr;gap:38px}.rf-anniversary-number{font-size:clamp(180px,56vw,280px)}.rf-anniversary-caption{font-size:23px;margin-top:20px}.rf-anniversary-dates{margin-top:10px}.rf-heritage-copy{grid-column:1;grid-row:auto}.rf-heritage-copy h2{font-size:42px}.rf-heritage-copy>p{font-size:14px;margin-top:22px}.rf-heritage-people{grid-column:1;grid-row:auto;max-width:100%;width:100%}.rf-heritage-people figcaption{max-width:none}.rf-timeline-wrap{margin-top:48px}.rf-timeline{display:block;border-left:1px solid var(--rule);margin-left:4px;padding-left:25px}.rf-timeline li{border:0;padding:0 0 30px}.rf-timeline li:last-child{padding-bottom:0}.rf-timeline li::before{left:-29px;top:6px}.rf-timeline h3{max-width:none;margin:9px 0 7px;font-size:22px}.rf-timeline p{max-width:35ch}.rf-milestone-year{font-size:13px}}
  @media(prefers-reduced-motion:reduce){.rf-timeline-rule>span{transform:none!important}.rf-timeline li{transform:none!important}}
</style>
