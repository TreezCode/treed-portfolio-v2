---
import { navigationResources as resources, footerResourceGroups, footerExploreLinks } from '../../data/handoff-navigation';
const {home=false}=Astro.props;
const socialLinks = [
  {name:'Instagram',href:'https://www.instagram.com/russoundfmpinc/',icon:'instagram'},
  {name:'Facebook',href:'https://www.facebook.com/RussoundFMPInc/',icon:'facebook'},
  {name:'YouTube',href:'https://www.youtube.com/c/RussoundFMP/videos',icon:'youtube'},
  {name:'LinkedIn',href:'https://www.linkedin.com/company/russound',icon:'linkedin'},
  {name:'X',href:'https://x.com/RussoundAudio',icon:'x'},
];
---
<footer class="ds-footer hf-footer-polished" id="footer">
  <section class="ds-newsletter" aria-labelledby="newsletter-title" id="newsletter">
    <div class="ds-newsletter-copy"><p class="ds-newsletter-eyebrow">Keep listening</p><h2 id="newsletter-title">The latest from Russound.</h2><p>Product news, listening ideas and offers, delivered to your inbox.</p></div>
    <div class="ds-newsletter-preview" role="group" aria-label="Newsletter signup preview" data-newsletter-preview>
      <label for="newsletter-email">Email address</label>
      <div class="ds-newsletter-entry"><input id="newsletter-email" type="email" required autocomplete="off" spellcheck="false" placeholder="you@example.com" aria-describedby="newsletter-preview-note" data-newsletter-email /><button type="button" data-newsletter-button>Sign up <span aria-hidden="true">↗</span></button></div>
      <p id="newsletter-preview-note" class="ds-newsletter-note">Concept preview. No email addresses are collected. <a href="https://russound.com/privacy-policy/">Privacy policy</a></p>
      <p class="ds-newsletter-status" role="status" aria-live="polite" data-newsletter-status></p>
    </div>
  </section>
  <div class="hf-footer-body">
  <div class="ds-footer-top">
    <div class="ds-footer-brand"><a href="/" aria-label="Russound home"><img src="/media/logo-dark.webp" width="360" height="81" alt="Russound" /></a><p>A sound relationship.{' '}<br />Since 1967.</p>
      <nav class="ds-social-links" aria-label="Follow Russound">{socialLinks.map(social=><a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`Russound on ${social.name} (opens in a new tab)`} title={social.name}>
        <svg viewBox="0 0 24 24" width={social.icon==='x'?17:20} height={social.icon==='x'?17:20} aria-hidden="true" focusable="false">
          {social.icon==='instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></>}
          {social.icon==='facebook' && <path fill="currentColor" d="M13.8 22v-9h3l.45-3.5H13.8V7.3c0-1 .3-1.7 1.8-1.7h1.9V2.5a25 25 0 0 0-2.8-.15c-2.8 0-4.7 1.7-4.7 4.8v2.35H7V13h3v9z"/>}
          {social.icon==='youtube' && <><rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m10 8 6 4-6 4z" fill="currentColor"/></>}
          {social.icon==='linkedin' && <><rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="7.3" cy="7.3" r="1.3" fill="currentColor"/><path fill="currentColor" d="M6.2 10h2.2v8H6.2zm4.3 0h2.1v1.1c.6-.9 1.4-1.3 2.4-1.3 2.2 0 3 1.4 3 3.5V18h-2.2v-4.3c0-1.2-.3-1.9-1.4-1.9-1.2 0-1.7.8-1.7 2V18h-2.2z"/></>}
          {social.icon==='x' && <path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.835L0 1.154h7.594l5.243 6.932L18.901 1.153ZM17.61 20.644h2.039L6.486 3.24H4.298L17.61 20.644Z"/>}
        </svg>
      </a>)}</nav>
    </div>
    <nav aria-label="Explore Russound"><h2>Explore</h2><a href="/audio-systems/">Audio systems</a><a href="/catalog/?family=amplifiers">Amplifiers</a><a href="/catalog/?family=speakers">Speakers</a><a href="/connectivity-control/">Connectivity &amp; Control</a>{footerExploreLinks.map(key => <a href={resources[key].href}>{resources[key].label}</a>)}</nav>
    {footerResourceGroups.map(group => <nav aria-label={group.label}><h2>{group.label}</h2>{group.links.map(key => <a href={resources[key].href}>{resources[key].label}</a>)}</nav>)}
  </div>
  <section class="ds-credentials" id="industry-recognition" aria-labelledby="industry-recognition-title">
    <h2 id="industry-recognition-title">Industry membership &amp; recognition</h2>
    <div class="ds-credentials-grid">
      <article class="ds-credential"><div class="ds-credential-art ds-credential-cedia"><img src="/oct28/cedia-member.png" width="250" height="125" alt="CEDIA Member" loading="lazy" /></div><div><h3>CEDIA member</h3><p>Professional industry association.</p><a href="https://cedia.org/">About CEDIA <span aria-hidden="true">↗</span></a></div></article>
      <article class="ds-credential"><div class="ds-credential-art"><img src="/oct28/cepro-q4q-2025.png" width="477" height="476" alt="CE Pro Quest for Quality 2025 Awards Winner" loading="lazy" /></div><div><h3>2025 Quest for Quality</h3><p>Platinum: Dealer Protection Policies.{' '}<br />Silver: Lead Generation.</p><a href="https://russound.com/russound-wins-2-quest-for-quality-awards-2025/">Read about the awards <span aria-hidden="true">↗</span></a></div></article>
    </div>
  </section>
  <div class="ds-footer-bottom"><p>Portfolio concept</p><div><a href="https://buildwithtreez.com/work/russound-digital-experience">Back to the case study</a><a href="https://russound.com/">Visit Russound.com</a></div></div>
  <p class="ds-footer-note">Explore the product collection and complete SMZ8 example. Dealer and professional resources open the current Russound website. </p>
<div class="ds-footer-note"><a href="/#how-it-works">How it works</a> · <a href="/#planner">Plan a system</a> · <a href="/#model-support">Find product help</a></div>
  </div>
</footer>
